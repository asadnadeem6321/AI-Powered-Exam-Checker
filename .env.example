# Django Settings
SECRET_KEY="your-secret-key-here"
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL)
DB_NAME=exam_checker_db
DB_USER=postgres
DB_PASSWORD=your-password
DB_HOST=localhost
DB_PORT=5432

# Claude API Key - THIS is where your API key goes!
# Get from: https://console.anthropic.com/account/keys
CLAUDE_API_KEY=sk-ant-your-actual-claude-api-key-here

# Celery & Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# JWT Settings
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# File Upload Settings
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
ALLOWED_FILE_TYPES=pdf,txt,jpg,jpeg,png

# Tesseract OCR Path
# For macOS (Intel): /usr/local/bin/tesseract
# For macOS (Apple Silicon/M1-M3): /opt/homebrew/bin/tesseract
# For Linux: /usr/bin/tesseract
# For Windows: C:\\Program Files\\Tesseract-OCR\\tesseract.exe
TESSERACT_CMD=/usr/local/bin/tesseract

# Evaluation Settings
SBERT_MODEL_NAME=all-MiniLM-L6-v2
SIMILARITY_WEIGHT=0.6
CONTEXT_WEIGHT=0.4
CLAUDE_MODEL=claude-3-5-sonnet-20241022
CLAUDE_MAX_TOKENS=1000
CLAUDE_TEMPERATURE=0.3

# Frontend URL (for CORS)
REACT_APP_API_URL=http://localhost:8000

# Frontend URL used in password reset links
FRONTEND_URL=http://localhost:3000

# Email / SMTP settings (required for real inbox delivery)
# For Gmail use: EMAIL_HOST=smtp.gmail.com and an app password
# If EMAIL_HOST is empty, backend falls back to console email backend.
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=noreply@example.com
